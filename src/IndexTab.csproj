<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IndexTab (Windows) — C# WPF 프로젝트 파일
    · WPF UI + WinForms NotifyIcon(트레이 아이콘) 동시 사용
    · net10.0-windows / x64 / Per-Monitor V2 DPI 인식(app.manifest)
    · 참고: 이 앱의 핵심(다른 앱 창 열거·raise)은 Win32 P/Invoke로 구현
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IndexTab</RootNamespace>
    <AssemblyName>IndexTab</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.1</Version>
    <!-- WPF 주도 앱: DPI 인식은 app.manifest(PerMonitorV2)로 지정하므로
         WinForms 전용 권고 경고(WFO0003)만 억제 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- 아이콘 파일이 있으면 실행 파일 아이콘으로 사용(없으면 무시) -->
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 트레이 아이콘 런타임 로드용: 출력 폴더로 복사 -->
    <None Include="Assets\app.ico" Condition="Exists('Assets\app.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      WPF + WinForms를 함께 쓰면 System.Drawing / System.Windows.Forms 가
      암시적으로 임포트돼 WPF 타입과 이름이 겹친다(Color, Point, Application 등).
      이 앱은 본질적으로 WPF이므로 겹치는 이름은 전역 별칭으로 WPF 쪽에 고정.
      (WinForms 트레이 아이콘은 AppController에서 'WinForms.' 별칭으로 명시 사용)
    -->
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.Media.Color" Alias="Color" />
    <Using Include="System.Windows.Media.Brushes" Alias="Brushes" />
    <Using Include="System.Windows.Point" Alias="Point" />
    <Using Include="System.Windows.Controls.Panel" Alias="Panel" />
    <Using Include="System.Windows.Controls.Orientation" Alias="Orientation" />
    <Using Include="System.Windows.Controls.Image" Alias="Image" />
    <Using Include="System.Windows.Controls.ContextMenu" Alias="ContextMenu" />
    <Using Include="System.Windows.Controls.MenuItem" Alias="MenuItem" />
  </ItemGroup>

</Project>
